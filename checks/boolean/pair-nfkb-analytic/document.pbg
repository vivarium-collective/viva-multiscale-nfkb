      "TNF": 0.0,
      "TNFR": 0.0,
      "XIAP": 0.0,
      "apoptosome": 0.0,
      "cFLIP": 0.0,
      "mROS": 0.0,
      "mXIAP": 0.0
    },
    "node_probabilities": {
      "ATP": 1.0,
      "Apoptosis": 0.0,
      "BAX": 0.0,
      "BCL2": 0.0,
      "CASP3": 0.0,
      "CASP8": 0.0,
      "Cyt_c": 0.0,
      "DISC_FAS": 0.0,
      "DISC_TNF": 0.0,
      "FADD": 1.0,
      "FASL": 0.0,
      "MOMP": 0.0,
      "MPT": 0.0,
      "NFkB": 0.0,
      "NonACD": 0.0,
      "RIP1": 0.0,
      "RIP1K": 0.0,
      "ROS": 0.0,
      "SMAC": 0.0,
      "Survival": 0.0,
      "TNF": 0.0,
      "TNFR": 0.0,
      "XIAP": 0.0,
      "apoptosome": 0.0,
      "cFLIP": 0.0,
      "mROS": 0.0,
      "mXIAP": 0.0
    },
    "parameters": {
      "u_NFkB": 0.0,
      "d_NFkB": 0.0
    },
    "steps": 0,
    "nfkb_total": 0.0,
    "nuclear_fraction": {
      "_type": "step",
      "address": "local:viva_basic_processes.math_expression.MathExpressionStep",
      "config": {
        "expressions": [
          {
            "out": "NFKB_total",
            "expr": "IKKactive_IkB_NFKB + NFKB + IkB_NFKB + (NFKB_nuc + IkB_NFKB_nuc) / Kv"
          },
          {
            "out": "u_NFkB",
            "expr": "(NFKB_nuc / Kv) / NFKB_total"
          },
          {
            "out": "d_NFkB",
            "expr": "1 - u_NFkB"
          }
        ],
        "params": {
          "Kv": 5.0
        }
      },
      "inputs": {
        "IKKactive_IkB_NFKB": [
          "kinetic",
          "IKKactive_IkB_NFKB"
        ],
        "NFKB": [
          "kinetic",
          "NFKB"
        ],
        "IkB_NFKB": [
          "kinetic",
          "IkB_NFKB"
        ],
        "NFKB_nuc": [
          "kinetic",
          "NFKB_nuc"
        ],
        "IkB_NFKB_nuc": [
          "kinetic",
          "IkB_NFKB_nuc"
        ]
      },
      "outputs": {
        "NFKB_total": [
          "nfkb_total"
        ],
        "u_NFkB": [
          "parameters",
          "u_NFkB"
        ],
        "d_NFkB": [
          "parameters",
          "d_NFkB"
        ]
      }
    },
    "cellfate": {
      "_type": "process",
      "address": "local:viva_maboss.processes.MaBoSSProcess",
      "config": {
        "network": "node FASL {\n  rate_up = 0;\n  rate_down = 0;\n}\n\nnode TNF {\n  rate_up = $u_TNF;\n  rate_down = $d_TNF;\n}\n\nnode TNFR {\n  logic = TNF;\n  rate_up = @logic ? 1 : 0;\n  rate_down = @logic ? 0 : 1;\n}\n\nnode FADD {\n  rate_up = 0;\n  rate_down = 0;\n}\n\nnode DISC_TNF {\n  logic = FADD AND TNFR;\n  rate_up = @logic ? 1 : 0;\n  rate_down = @logic ? 0 : 1;\n}\n\nnode DISC_FAS {\n  logic = FASL AND FADD;\n  rate_up = @logic ? 1 : 0;\n  rate_down = @logic ? 0 : 1;\n}\n\nnode CASP8 {\n  logic = (DISC_TNF OR (DISC_FAS OR CASP3)) AND (NOT cFLIP);\n  rate_up = ($Low_CASP8 ? 0 : (@logic ? 1 : 0));\n  rate_down = ($Low_CASP8 ? 1e+100 : (@logic ? 0 : 1));\n}\n\nnode RIP1 {\n  logic = (DISC_FAS OR TNFR) AND (NOT CASP8);\n  rate_up = ($Low_RIP1 ? 0 : (@logic ? 1 : 0));\n  rate_down = ($Low_RIP1 ? 1e+100 : (@logic ? 0 : 1));\n}\n\nnode RIP1K {\n  logic = RIP1;\n  rate_up = @logic ? 1 : 0;\n  rate_down = @logic ? 0 : 1;\n}\n\nnode CASP3 {\n  logic = apoptosome AND (NOT XIAP);\n  rate_up = @logic ? 1 : 0;\n  rate_down = @logic ? 0 : 1;\n}\n\nnode NFkB {\n  logic = NOT CASP3;\n  rate_up = ($High_NFkB ? 1e+100 : (@logic ? $u_NFkB : 0));\n  rate_down = ($High_NFkB ? 0 : (@logic ? $d_NFkB : 1));\n}\n\nnode cFLIP {\n  logic = NFkB;\n  rate_up = (@logic) ? $TransRate : 0;\n  rate_down = (@logic ? 0 : 1);\n}\n\nnode BCL2 {\n  logic = NFkB;\n  rate_up = (@logic ? $TransRate : 0);\n  rate_down = @logic ? 0 : 1;\n}\n\nnode BAX {\n  logic = CASP8 AND (NOT BCL2);\n  rate_up = @logic ? 1 : 0;\n  rate_down = @logic ? 0 : 1;\n}\n\nnode mROS {\n  logic = (NOT NFkB);\n  rate_up = @logic ? $TransRate : 0;\n  rate_down = @logic ? 0 : 1;\n}\n\nnode MPT {\n  logic = (NOT BCL2) AND ROS;\n  rate_up = @logic ? 1 : 0;\n  rate_down = @logic ? 0 : 1;\n}\n\nnode ROS {\n  logic = (mROS) AND (MPT OR RIP1K);\n  rate_up = @logic ? 1 : 0;\n  rate_down = @logic ? 0 : 1;\n}\n\nnode ATP {\n  logic = NOT MPT;\n  rate_up = @logic ? 1 : 0;\n  rate_down = @logic ? 0 : 1;\n}\n\nnode MOMP {\n  logic = BAX OR MPT;\n  rate_up = @logic ? 1 : 0;\n  rate_down = @logic ? 0 : 1;\n}\n\nnode SMAC {\n  logic = MOMP;\n  rate_up = @logic ? 1 : 0;\n  rate_down = @logic ? 0 : 1;\n}\n\nnode Cyt_c {\n  logic = MOMP;\n  rate_up = @logic ? 1 : 0;\n  rate_down = @logic ? 0 : 1;\n}\n\nnode mXIAP {\n  logic = (NFkB);\n  rate_up = @logic ? $TransRate : 0;\n  rate_down = @logic ? 0 : 1;\n}\n\nnode XIAP {\n  logic = (NOT SMAC) AND mXIAP;\n  rate_up = (@logic) ? 1 : 0;\n  rate_down = (@logic ? 0 : 1);\n}\n\nnode apoptosome {\n  logic = Cyt_c AND (ATP AND (NOT XIAP));\n  rate_up = (@logic) ? 1 : 0;\n  rate_down = (@logic ? 0 : 1);\n}\n\nnode NonACD {\n  logic = NOT ATP;\n  rate_up = @logic ? 1 : 0;\n  rate_down = @logic ? 0 : 1;\n}\n\nnode Apoptosis {\n  logic = CASP3;\n  rate_up = @logic ? 1 : 0;\n  rate_down = @logic ? 0 : 1;\n}\n\nnode Survival {\n  logic = NFkB;\n  rate_up = @logic ? $TransRate : 0;\n  rate_down = @logic ? 0 : 1;\n}\n",
        "parameters": {
          "High_NFkB": 0.0,
          "Low_CASP8": 0.0,
          "Low_RIP1": 0.0,
          "TransRate": 0.041666666666666664,
          "u_NFkB": 0.0,
          "d_NFkB": 0.0,
          "u_TNF": 0.0,
          "d_TNF": 0.0
        },
        "initial_state": {
          "FADD": 1.0,
          "ATP": 1.0
        },
        "sample_count": 50000,
        "windows_per_interval": 20,
        "seed": 11
      },
      "interval": 2.0,
      "inputs": {
        "node_state": [
          "node_state"
        ],
        "node_probabilities": [
          "node_probabilities"
        ],
        "parameters": [
          "parameters"
        ],
        "steps": [
          "steps"
        ]
      },
      "outputs": {
        "node_state": [
          "node_state"
        ],
        "node_probabilities": [
          "node_probabilities"
        ],
        "steps": [
          "steps"
        ]
      }
    },
    "emitter": {
      "_type": "step",
      "address": "local:RAMEmitter",
      "config": {
        "emit": {
          "node_probabilities": "map[float]",
          "parameters": "map[float]",
          "nfkb_total": "float",
          "steps": "integer"
        }
      },
      "inputs": {
        "node_probabilities": [
          "node_probabilities"
        ],
        "parameters": [
          "parameters"
        ],
        "nfkb_total": [
          "nfkb_total"
        ],
        "steps": [
          "steps"
        ]
      }
    }
  }
}
