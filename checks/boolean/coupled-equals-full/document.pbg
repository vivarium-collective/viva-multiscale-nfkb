    },
    "parameters": {},
    "steps": 0,
    "cellfate": {
      "_type": "process",
      "address": "local:viva_maboss.processes.MaBoSSProcess",
      "config": {
        "network": "node FASL {\n  rate_up = $k_time * (0);\n  rate_down = $k_time * (0);\n}\n\nnode TNF {\n  rate_up = $k_time * ($u_TNF);\n  rate_down = $k_time * ($d_TNF);\n}\n\nnode TNFR {\n  logic = TNF;\n  rate_up = $k_time * (@logic ? 1 : 0);\n  rate_down = $k_time * (@logic ? 0 : 1);\n}\n\nnode FADD {\n  rate_up = $k_time * (0);\n  rate_down = $k_time * (0);\n}\n\nnode DISC_TNF {\n  logic = FADD AND TNFR;\n  rate_up = $k_time * (@logic ? 1 : 0);\n  rate_down = $k_time * (@logic ? 0 : 1);\n}\n\nnode DISC_FAS {\n  logic = FASL AND FADD;\n  rate_up = $k_time * (@logic ? 1 : 0);\n  rate_down = $k_time * (@logic ? 0 : 1);\n}\n\nnode CASP8 {\n  logic = (DISC_TNF OR (DISC_FAS OR CASP3)) AND (NOT cFLIP);\n  rate_up = $k_time * (($Low_CASP8 ? 0 : (@logic ? 1 : 0)));\n  rate_down = $k_time * (($Low_CASP8 ? 1e+100 : (@logic ? 0 : 1)));\n}\n\nnode RIP1 {\n  logic = (DISC_FAS OR TNFR) AND (NOT CASP8);\n  rate_up = $k_time * (($Low_RIP1 ? 0 : (@logic ? 1 : 0)));\n  rate_down = $k_time * (($Low_RIP1 ? 1e+100 : (@logic ? 0 : 1)));\n}\n\nnode cIAP {\n  logic = (mcIAP AND (NOT SMAC));\n  rate_up = $k_time * (($Low_cIAP ? 0 : (@logic ? ($r_tx / $k_time) : 0)));\n  rate_down = $k_time * (($Low_cIAP ? 1e+100 : ((SMAC) ? 1 : 0)));\n}\n\nnode RIP1ub {\n  logic = cIAP AND RIP1;\n  rate_up = $k_time * (@logic ? 1 : 0);\n  rate_down = $k_time * (@logic ? 0 : 1);\n}\n\nnode RIP1K {\n  logic = RIP1;\n  rate_up = $k_time * (@logic ? 1 : 0);\n  rate_down = $k_time * (@logic ? 0 : 1);\n}\n\nnode IKK {\n  logic = RIP1ub;\n  rate_up = $k_time * (@logic ? 1 : 0);\n  rate_down = $k_time * (@logic ? 0 : 1);\n}\n\nnode CASP3 {\n  logic = apoptosome AND (NOT XIAP);\n  rate_up = $k_time * (@logic ? 1 : 0);\n  rate_down = $k_time * (@logic ? 0 : 1);\n}\n\nnode NFkB {\n  logic = IKK AND (NOT CASP3);\n  rate_up = $k_time * (($High_NFkB ? 1e+100 : (@logic ? $u_NFkB : 0)));\n  rate_down = $k_time * (($High_NFkB ? 0 : (@logic ? $d_NFkB : 1)));\n}\n\nnode cFLIP {\n  logic = NFkB;\n  rate_up = $k_time * ((@logic) ? ($r_tx / $k_time) : 0);\n  rate_down = $k_time * ((@logic ? 0 : 1));\n}\n\nnode BCL2 {\n  logic = NFkB;\n  rate_up = $k_time * ((@logic ? ($r_tx / $k_time) : 0));\n  rate_down = $k_time * (@logic ? 0 : 1);\n}\n\nnode BAX {\n  logic = CASP8 AND (NOT BCL2);\n  rate_up = $k_time * (@logic ? 1 : 0);\n  rate_down = $k_time * (@logic ? 0 : 1);\n}\n\nnode mROS {\n  logic = (NOT NFkB);\n  rate_up = $k_time * (@logic ? ($r_tx / $k_time) : 0);\n  rate_down = $k_time * (@logic ? 0 : 1);\n}\n\nnode MPT {\n  logic = (NOT BCL2) AND ROS;\n  rate_up = $k_time * (@logic ? 1 : 0);\n  rate_down = $k_time * (@logic ? 0 : 1);\n}\n\nnode ROS {\n  logic = (mROS) AND (MPT OR RIP1K);\n  rate_up = $k_time * (@logic ? 1 : 0);\n  rate_down = $k_time * (@logic ? 0 : 1);\n}\n\nnode ATP {\n  logic = NOT MPT;\n  rate_up = $k_time * (@logic ? 1 : 0);\n  rate_down = $k_time * (@logic ? 0 : 1);\n}\n\nnode MOMP {\n  logic = BAX OR MPT;\n  rate_up = $k_time * (@logic ? 1 : 0);\n  rate_down = $k_time * (@logic ? 0 : 1);\n}\n\nnode SMAC {\n  logic = MOMP;\n  rate_up = $k_time * (@logic ? 1 : 0);\n  rate_down = $k_time * (@logic ? 0 : 1);\n}\n\nnode mcIAP {\n  logic = (NFkB);\n  rate_up = $k_time * (@logic ? ($r_tx / $k_time) : 0);\n  rate_down = $k_time * (@logic ? 0 : 1);\n}\n\nnode Cyt_c {\n  logic = MOMP;\n  rate_up = $k_time * (@logic ? 1 : 0);\n  rate_down = $k_time * (@logic ? 0 : 1);\n}\n\nnode mXIAP {\n  logic = (NFkB);\n  rate_up = $k_time * (@logic ? ($r_tx / $k_time) : 0);\n  rate_down = $k_time * (@logic ? 0 : 1);\n}\n\nnode XIAP {\n  logic = (NOT SMAC) AND mXIAP;\n  rate_up = $k_time * ((@logic) ? 1 : 0);\n  rate_down = $k_time * ((@logic ? 0 : 1));\n}\n\nnode apoptosome {\n  logic = Cyt_c AND (ATP AND (NOT XIAP));\n  rate_up = $k_time * ((@logic) ? 1 : 0);\n  rate_down = $k_time * ((@logic ? 0 : 1));\n}\n\nnode NonACD {\n  logic = NOT ATP;\n  rate_up = $k_time * (@logic ? 1 : 0);\n  rate_down = $k_time * (@logic ? 0 : ($absorb_death ? 0 : 1));\n}\n\nnode Apoptosis {\n  logic = CASP3;\n  rate_up = $k_time * (@logic ? 1 : 0);\n  rate_down = $k_time * (@logic ? 0 : ($absorb_death ? 0 : 1));\n}\n\nnode Survival {\n  logic = NFkB;\n  rate_up = $k_time * (@logic ? ($r_tx / $k_time) : 0);\n  rate_down = $k_time * (@logic ? 0 : 1);\n}\n",
        "parameters": {
          "High_NFkB": 0.0,
          "Low_CASP8": 0.0,
          "Low_RIP1": 0.0,
          "Low_cIAP": 0.0,
          "u_TNF": 0.0,
          "d_TNF": 0.0,
          "u_NFkB": 1.0,
          "d_NFkB": 0.0,
          "absorb_death": 0.0,
          "k_time": 1.0,
          "r_tx": 0.041666666666666664
        },
        "initial_state": {
          "ATP": 1.0,
          "FADD": 1.0,
          "TNF": 1.0,
          "cIAP": 1.0
        },
        "sample_count": 50000,
        "windows_per_interval": 20,
        "seed": 7
      },
      "interval": 40.0,
      "inputs": {
        "node_state": [
          "node_state"
        ],
        "node_probabilities": [
          "node_probabilities"
        ],
        "parameters": [
          "parameters"
        ],
        "steps": [
          "steps"
        ]
      },
      "outputs": {
