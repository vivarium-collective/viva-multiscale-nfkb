    "parameters": {
      "u_NFkB": 0.0,
      "d_NFkB": 0.0
    },
    "steps": 0,
    "nfkb_total": 0.0,
    "nuclear_fraction": {
      "_type": "step",
      "address": "local:viva_basic_processes.math_expression.MathExpressionStep",
      "config": {
        "expressions": [
          {
            "out": "NFKB_total",
            "expr": "IKKactive_IkB_NFKB + NFKB + IkB_NFKB + (1 / Kv) * NFKB_nuc + (1 / Kv) * IkB_NFKB_nuc"
          },
          {
            "out": "u_NFkB",
            "expr": "(NFKB_nuc / Kv) / NFKB_total"
          },
          {
            "out": "d_NFkB",
            "expr": "1 - u_NFkB"
          }
        ],
        "params": {
          "Kv": 5.0
        }
      },
      "inputs": {
        "IKKactive_IkB_NFKB": [
          "kinetic",
          "IKKactive_IkB_NFKB"
        ],
        "NFKB": [
