{
  "global_time_precision": 6,
  "state": {
    "kinetic": {
      "IKKactive_IkB_NFKB": 3.2746876968303695e-05,
      "NFKB": 0.02616054192185402,
      "IkB_NFKB": 4.180367250228301e-05,
      "NFKB_nuc": 0.16880343854427338,
      "IkB_NFKB_nuc": 2.110206514771562e-05
    },
    "node_state": {
      "CASP3": 0.0,
      "IKK": 1.0,
