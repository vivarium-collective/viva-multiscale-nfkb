        ],
        "IkB_NFKB_nuc": [
          "kinetic",
          "IkB_NFKB_nuc"
        ]
      },
      "outputs": {
        "NFKB_total": [
          "nfkb_total"
        ],
        "u_NFkB": [
          "parameters",
          "u_NFkB"
        ],
        "d_NFkB": [
