          "d_NFkB"
        ]
      }
    },
    "cellfate": {
      "_type": "process",
      "address": "local:viva_maboss.processes.MaBoSSProcess",
      "config": {
        "network": "node IKK {\n  rate_up = 0;\n  rate_down = 0;\n}\n\nnode CASP3 {\n  rate_up = 0;\n  rate_down = 0;\n}\n\nnode NFkB {\n  logic = IKK AND (NOT CASP3);\n  rate_up = $k_time * (($High_NFkB ? 1e+100 : (@logic ? $u_NFkB : 0)));\n  rate_down = $k_time * (($High_NFkB ? 0 : (@logic ? $d_NFkB : 1)));\n}\n",
        "parameters": {
          "High_NFkB": 0.0,
          "u_NFkB": 0.0,
          "d_NFkB": 0.0,
          "k_time": 0.0016666666666666668
        },
        "initial_state": {
          "IKK": 1.0
        },
        "sample_count": 50000,
        "windows_per_interval": 20,
        "seed": 11
      },
      "interval": 1200.0,
      "inputs": {
        "node_state": [
          "node_state"
        ],
        "node_probabilities": [
          "node_probabilities"
        ],
        "parameters": [
