   <rdf:Description rdf:about=\"#COPASI82\">\n                <bqbiol:hasProperty rdf:resource=\"urn:miriam:ncit:C18103\"/>\n                <dcterms:created>\n                  <rdf:Description>\n                    <dcterms:W3CDTF>2019-08-09T12:11:02Z</dcterms:W3CDTF>\n                  </rdf:Description>\n                </dcterms:created>\n              </rdf:Description>\n            </rdf:RDF>\n          </COPASI>\n        </annotation>\n        <listOfProducts>\n          <speciesReference species=\"NFKB_nuc\" stoichiometry=\"1\"/>\n        </listOfProducts>\n        <listOfModifiers>\n          <modifierSpeciesReference species=\"NFKB\"/>\n        </listOfModifiers>\n        <kineticLaw>\n          <math xmlns=\"http://www.w3.org/1998/Math/MathML\">\n            <apply>\n              <ci> function_for_indirect_transport </ci>\n              <ci> i1 </ci>\n              <ci> Kv </ci>\n              <ci> NFKB </ci>\n            </apply>\n          </math>\n        </kineticLaw>\n      </reaction>\n      <reaction metaid=\"COPASI83\" id=\"IkBn_induced_IkBc_production\" name=\"IkBn_induced_IkBc_production\" reversible=\"false\">\n        <annotation>\n          <rdf:RDF xmlns:rdf=\"http://www.w3.org/1999/02/22-rdf-syntax-ns#\" xmlns:dc=\"http://purl.org/dc/elements/1.1/\" xmlns:dcterms=\"http://purl.org/dc/terms/\" xmlns:vCard=\"http://www.w3.org/2001/vcard-rdf/3.0#\" xmlns:bqbiol=\"http://biomodels.net/biology-qualifiers/\" xmlns:bqmodel=\"http://biomodels.net/model-qualifiers/\">\n            <rdf:Description rdf:about=\"#COPASI83\">\n              <bqbiol:hasPart>\n                <rdf:Bag>\n                  <rdf:li rdf:resource=\"http://identifiers.org/ncit/C18103\"/>\n                </rdf:Bag>\n              </bqbiol:hasPart>\n            </rdf:Description>\n          </rdf:RDF>\n          <COPASI xmlns=\"http://www.copasi.org/static/sbml\">\n            <rdf:RDF xmlns:CopasiMT=\"http://www.copasi.org/RDF/MiriamTerms#\" xmlns:dcterms=\"http://purl.org/dc/terms/\" xmlns:rdf=\"http://www.w3.org/1999/02/22-rdf-syntax-ns#\">\n              <rdf:Description rdf:about=\"#COPASI83\">\n                <dcterms:created>\n                  <rdf:Description>\n                    <dcterms:W3CDTF>2019-08-09T12:15:50Z</dcterms:W3CDTF>\n                  </rdf:Description>\n                </dcterms:created>\n                <CopasiMT:hasPart rdf:resource=\"urn:miriam:ncit:C18103\"/>\n              </rdf:Description>\n            </rdf:RDF>\n          </COPASI>\n        </annotation>\n        <listOfProducts>\n          <speciesReference species=\"IkB\" stoichiometry=\"1\"/>\n        </listOfProducts>\n        <listOfModifiers>\n          <modifierSpeciesReference species=\"IkB_nuc\"/>\n        </listOfModifiers>\n        <kineticLaw>\n          <math xmlns=\"http://www.w3.org/1998/Math/MathML\">\n            <apply>\n              <ci> function_for_indirect_production </ci>\n              <ci> e1a </ci>\n              <ci> IkB_nuc </ci>\n            </apply>\n          </math>\n        </kineticLaw>\n      </reaction>\n      <reaction metaid=\"COPASI84\" id=\"IkBc_induced_IkBn_production\" name=\"IkBc_induced_IkBn_production\" reversible=\"false\">\n        <annotation>\n          <rdf:RDF xmlns:rdf=\"http://www.w3.org/1999/02/22-rdf-syntax-ns#\" xmlns:dc=\"http://purl.org/dc/elements/1.1/\" xmlns:dcterms=\"http://purl.org/dc/terms/\" xmlns:vCard=\"http://www.w3.org/2001/vcard-rdf/3.0#\" xmlns:bqbiol=\"http://biomodels.net/biology-qualifiers/\" xmlns:bqmodel=\"http://biomodels.net/model-qualifiers/\">\n            <rdf:Description rdf:about=\"#COPASI84\">\n              <bqbiol:hasProperty>\n                <rdf:Bag>\n                  <rdf:li rdf:resource=\"http://identifiers.org/ncit/C18103\"/>\n                </rdf:Bag>\n              </bqbiol:hasProperty>\n            </rdf:Description>\n          </rdf:RDF>\n          <COPASI xmlns=\"http://www.copasi.org/static/sbml\">\n            <rdf:RDF xmlns:bqbiol=\"http://biomodels.net/biology-qualifiers/\" xmlns:dcterms=\"http://purl.org/dc/terms/\" xmlns:rdf=\"http://www.w3.org/1999/02/22-rdf-syntax-ns#\">\n              <rdf:Description rdf:about=\"#COPASI84\">\n                <bqbiol:hasProperty rdf:resource=\"urn:miriam:ncit:C18103\"/>\n                <dcterms:created>\n                  <rdf:Description>\n                    <dcterms:W3CDTF>2019-08-09T12:17:07Z</dcterms:W3CDTF>\n                  </rdf:Description>\n                </dcterms:created>\n              </rdf:Description>\n            </rdf:RDF>\n          </COPASI>\n        </annotation>\n        <listOfProducts>\n          <speciesReference species=\"IkB_nuc\" stoichiometry=\"1\"/>\n        </listOfProducts>\n        <listOfModifiers>\n          <modifierSpeciesReference species=\"IkB\"/>\n        </listOfModifiers>\n        <kineticLaw>\n          <math xmlns=\"http://www.w3.org/1998/Math/MathML\">\n            <apply>\n              <ci> function_for_indirect_transport </ci>\n              <ci> i1a </ci>\n              <ci> Kv </ci>\n              <ci> IkB </ci>\n            </apply>\n          </math>\n        </kineticLaw>\n      </reaction>\n      <reaction metaid=\"COPASI85\" id=\"IkB_NFKB_n_induced_IkB_NFKBc_production\" name=\"IkB_NFKB_n_induced_IkB_NFKBc_production\" reversible=\"false\">\n        <annotation>\n          <rdf:RDF xmlns:rdf=\"http://www.w3.org/1999/02/22-rdf-syntax-ns#\" xmlns:dc=\"http://purl.org/dc/elements/1.1/\" xmlns:dcterms=\"http://purl.org/dc/terms/\" xmlns:vCard=\"http://www.w3.org/2001/vcard-rdf/3.0#\" xmlns:bqbiol=\"http://biomodels.net/biology-qualifiers/\" xmlns:bqmodel=\"http://biomodels.net/model-qualifiers/\">\n            <rdf:Description rdf:about=\"#COPASI85\">\n              <bqbiol:hasProperty>\n                <rdf:Bag>\n                  <rdf:li rdf:resource=\"http://identifiers.org/ncit/C18103\"/>\n                </rdf:Bag>\n              </bqbiol:hasProperty>\n            </rdf:Description>\n          </rdf:RDF>\n          <COPASI xmlns=\"http://www.copasi.org/static/sbml\">\n            <rdf:RDF xmlns:bqbiol=\"http://biomodels.net/biology-qualifiers/\" xmlns:dcterms=\"http://purl.org/dc/terms/\" xmlns:rdf=\"http://www.w3.org/1999/02/22-rdf-syntax-ns#\">\n              <rdf:Description rdf:about=\"#COPASI85\">\n                <bqbiol:hasProperty rdf:resource=\"urn:miriam:ncit:C18103\"/>\n                <dcterms:created>\n                  <rdf:Description>\n                    <dcterms:W3CDTF>2019-08-09T12:26:25Z</dcterms:W3CDTF>\n                  </rdf:Description>\n                </dcterms:created>\n              </rdf:Description>\n            </rdf:RDF>\n          </COPASI>\n        </annotation>\n        <listOfProducts>\n          <speciesReference species=\"IkB_NFKB\" stoichiometry=\"1\"/>\n        </listOfProducts>\n        <listOfModifiers>\n          <modifierSpeciesReference species=\"IkB_NFKB_nuc\"/>\n        </listOfModifiers>\n        <kineticLaw>\n          <math xmlns=\"http://www.w3.org/1998/Math/MathML\">\n            <apply>\n              <ci> function_for_indirect_production </ci>\n              <ci> e2a </ci>\n              <ci> IkB_NFKB_nuc </ci>\n            </apply>\n          </math>\n        </kineticLaw>\n      </reaction>\n    </listOfReactions>\n  </model>\n</sbml>\n", "model_format": "sbml", "bulk_species": false, "species_overrides": {"IKK_neutral": 0.19999999999999998, "IKK_active": 5.360693719995987e-28, "IKK_inact": 5.098700743695883e-27, "IKKactive_IkB": 2.695407643368284e-30, "IkB": 0.0025066291993849194, "IKKactive_IkB_NFKB": 3.245202370383302e-28, "IkB_NFKB": 0.059209565687822846, "NFKB": 0.0003155054774972614, "NFKB_nuc": 0.002295766799242719, "IkB_nuc": 0.0034357309572257922, "IkB_NFKB_nuc": 7.887637063700855e-05, "IkB_mRNA": 2.8697085790772093e-06, "A20_mRNA": 2.8697085790772084e-06, "A20": 0.004782847514569224, "cgen_mRNA": 2.869708579077208e-06}}, "interval": 30.0, "inputs": {"parameters_in": ["tnf_occupancy"]}, "outputs": {"species": ["species"], "time": ["kinetic_time"]}}, "nfkb_total": 0.0, "nfkb_fraction": 0.0, "nfkb_fraction_time": 0.0, "kinetic_time": 0.0, "parameters": {"u_NFkB": 0.0, "d_NFkB": 0.0, "u_TNF": 0.0, "d_TNF": 0.0}, "nuclear_fraction": {"_type": "step", "address": "local:viva_basic_processes.math_expression.MathExpressionStep", "config": {"expressions": [{"out": "NFKB_total", "expr": "IKKactive_IkB_NFKB + NFKB + IkB_NFKB + (1 / Kv) * NFKB_nuc + (1 / Kv) * IkB_NFKB_nuc"}, {"out": "f", "expr": "(NFKB_nuc / Kv) / NFKB_total"}, {"out": "u_NFkB", "expr": "f * kappa / k_time"}, {"out": "d_NFkB", "expr": "(1 - f) * kappa / k_time"}, {"out": "f_time", "expr": "kinetic_time"}], "params": {"Kv": 5.0, "kappa": 0.0020568165595250603, "k_time": 0.008333333333333333}}, "inputs": {"IKKactive_IkB_NFKB": ["species", "IKKactive_IkB_NFKB"], "NFKB": ["species", "NFKB"], "IkB_NFKB": ["species", "IkB_NFKB"], "NFKB_nuc": ["species", "NFKB_nuc"], "IkB_NFKB_nuc": ["species", "IkB_NFKB_nuc"], "kinetic_time": ["kinetic_time"]}, "outputs": {"NFKB_total": ["nfkb_total"], "f": ["nfkb_fraction"], "f_time": ["nfkb_fraction_time"], "u_NFkB": ["parameters", "u_NFkB"], "d_NFkB": ["parameters", "d_NFkB"]}}, "node_state": {"ATP": 1.0, "Apoptosis": 0.0, "BAX": 0.0, "BCL2": 0.0, "CASP3": 0.0, "CASP8": 0.0, "Cyt_c": 0.0, "DISC_FAS": 0.0, "DISC_TNF": 0.0, "FADD": 1.0, "FASL": 0.0, "IKK": 0.0, "MOMP": 0.0, "MPT": 0.0, "NFkB": 0.0, "NonACD": 0.0, "RIP1": 0.0, "RIP1K": 0.0, "RIP1ub": 0.0, "ROS": 0.0, "SMAC": 0.0, "Survival": 0.0, "TNF": 0.0, "TNFR": 0.0, "XIAP": 0.0, "apoptosome": 0.0, "cFLIP": 0.0, "cIAP": 1.0, "mROS": 0.0, "mXIAP": 0.0, "mcIAP": 0.0}, "node_probabilities": {"ATP": 1.0, "Apoptosis": 0.0, "BAX": 0.0, "BCL2": 0.0, "CASP3": 0.0, "CASP8": 0.0, "Cyt_c": 0.0, "DISC_FAS": 0.0, "DISC_TNF": 0.0, "FADD": 1.0, "FASL": 0.0, "IKK": 0.0, "MOMP": 0.0, "MPT": 0.0, "NFkB": 0.0, "NonACD": 0.0, "RIP1": 0.0, "RIP1K": 0.0, "RIP1ub": 0.0, "ROS": 0.0, "SMAC": 0.0, "Survival": 0.0, "TNF": 0.0, "TNFR": 0.0, "XIAP": 0.0, "apoptosome": 0.0, "cFLIP": 0.0, "cIAP": 1.0, "mROS": 0.0, "mXIAP": 0.0, "mcIAP": 0.0}, "steps": 0, "cellfate": {"_type": "process", "address": "local:viva_maboss.processes.MaBoSSProcess", "config": {"network": "node FASL {\n  rate_up = $k_time * (0);\n  rate_down = $k_time * (0);\n}\n\nnode TNF {\n  rate_up = $k_time * ($u_TNF);\n  rate_down = $k_time * ($d_TNF);\n}\n\nnode TNFR {\n  logic = TNF;\n  rate_up = $k_time * (@logic ? 1 : 0);\n  rate_down = $k_time * (@logic ? 0 : 1);\n}\n\nnode FADD {\n  rate_up = $k_time * (0);\n  rate_down = $k_time * (0);\n}\n\nnode DISC_TNF {\n  logic = FADD AND TNFR;\n  rate_up = $k_time * (@logic ? 1 : 0);\n  rate_down = $k_time * (@logic ? 0 : 1);\n}\n\nnode DISC_FAS {\n  logic = FASL AND FADD;\n  rate_up = $k_time * (@logic ? 1 : 0);\n  rate_down = $k_time * (@logic ? 0 : 1);\n}\n\nnode CASP8 {\n  logic = (DISC_TNF OR (DISC_FAS OR CASP3)) AND (NOT cFLIP);\n  rate_up = $k_time * (($Low_CASP8 ? 0 : (@logic ? 1 : 0)));\n  rate_down = $k_time * (($Low_CASP8 ? 1e+100 : (@logic ? 0 : 1)));\n}\n\nnode RIP1 {\n  logic = (DISC_FAS OR TNFR) AND (NOT CASP8);\n  rate_up = $k_time * (($Low_RIP1 ? 0 : (@logic ? 1 : 0)));\n  rate_down = $k_time * (($Low_RIP1 ? 1e+100 : (@logic ? 0 : 1)));\n}\n\nnode cIAP {\n  logic = (mcIAP AND (NOT SMAC));\n  rate_up = $k_time * (($Low_cIAP ? 0 : (@logic ? ($r_tx / $k_time) : 0)));\n  rate_down = $k_time * (($Low_cIAP ? 1e+100 : ((SMAC) ? 1 : 0)));\n}\n\nnode RIP1ub {\n  logic = cIAP AND RIP1;\n  rate_up = $k_time * (@logic ? 1 : 0);\n  rate_down = $k_time * (@logic ? 0 : 1);\n}\n\nnode RIP1K {\n  logic = RIP1;\n  rate_up = $k_time * (@logic ? 1 : 0);\n  rate_down = $k_time * (@logic ? 0 : 1);\n}\n\nnode IKK {\n  logic = RIP1ub;\n  rate_up = $k_time * (@logic ? 1 : 0);\n  rate_down = $k_time * (@logic ? 0 : 1);\n}\n\nnode CASP3 {\n  logic = apoptosome AND (NOT XIAP);\n  rate_up = $k_time * (@logic ? 1 : 0);\n  rate_down = $k_time * (@logic ? 0 : 1);\n}\n\nnode NFkB {\n  logic = IKK AND (NOT CASP3);\n  rate_up = $k_time * (($High_NFkB ? 1e+100 : (@logic ? $u_NFkB : 0)));\n  rate_down = $k_time * (($High_NFkB ? 0 : (@logic ? $d_NFkB : 1)));\n}\n\nnode cFLIP {\n  logic = NFkB;\n  rate_up = $k_time * ((@logic) ? ($r_tx / $k_time) : 0);\n  rate_down = $k_time * ((@logic ? 0 : 1));\n}\n\nnode BCL2 {\n  logic = NFkB;\n  rate_up = $k_time * ((@logic ? ($r_tx / $k_time) : 0));\n  rate_down = $k_time * (@logic ? 0 : 1);\n}\n\nnode BAX {\n  logic = CASP8 AND (NOT BCL2);\n  rate_up = $k_time * (@logic ? 1 : 0);\n  rate_down = $k_time * (@logic ? 0 : 1);\n}\n\nnode mROS {\n  logic = (NOT NFkB);\n  rate_up = $k_time * (@logic ? ($r_tx / $k_time) : 0);\n  rate_down = $k_time * (@logic ? 0 : 1);\n}\n\nnode MPT {\n  logic = (NOT BCL2) AND ROS;\n  rate_up = $k_time * (@logic ? 1 : 0);\n  rate_down = $k_time * (@logic ? 0 : 1);\n}\n\nnode ROS {\n  logic = (mROS) AND (MPT OR RIP1K);\n  rate_up = $k_time * (@logic ? 1 : 0);\n  rate_down = $k_time * (@logic ? 0 : 1);\n}\n\nnode ATP {\n  logic = NOT MPT;\n  rate_up = $k_time * (@logic ? 1 : 0);\n  rate_down = $k_time * (@logic ? 0 : 1);\n}\n\nnode MOMP {\n  logic = BAX OR MPT;\n  rate_up = $k_time * (@logic ? 1 : 0);\n  rate_down = $k_time * (@logic ? 0 : 1);\n}\n\nnode SMAC {\n  logic = MOMP;\n  rate_up = $k_time * (@logic ? 1 : 0);\n  rate_down = $k_time * (@logic ? 0 : 1);\n}\n\nnode mcIAP {\n  logic = (NFkB);\n  rate_up = $k_time * (@logic ? ($r_tx / $k_time) : 0);\n  rate_down = $k_time * (@logic ? 0 : 1);\n}\n\nnode Cyt_c {\n  logic = MOMP;\n  rate_up = $k_time * (@logic ? 1 : 0);\n  rate_down = $k_time * (@logic ? 0 : 1);\n}\n\nnode mXIAP {\n  logic = (NFkB);\n  rate_up = $k_time * (@logic ? ($r_tx / $k_time) : 0);\n  rate_down = $k_time * (@logic ? 0 : 1);\n}\n\nnode XIAP {\n  logic = (NOT SMAC) AND mXIAP;\n  rate_up = $k_time * ((@logic) ? 1 : 0);\n  rate_down = $k_time * ((@logic ? 0 : 1));\n}\n\nnode apoptosome {\n  logic = Cyt_c AND (ATP AND (NOT XIAP));\n  rate_up = $k_time * ((@logic) ? 1 : 0);\n  rate_down = $k_time * ((@logic ? 0 : 