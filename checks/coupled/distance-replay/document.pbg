aid=\"COPASI49\" id=\"TNF_R\" name=\"TNF_R\" value=\"0\" constant=\"false\">\n        <annotation>\n          <COPASI xmlns=\"http://www.copasi.org/static/sbml\">\n            <rdf:RDF xmlns:dcterms=\"http://purl.org/dc/terms/\" xmlns:rdf=\"http://www.w3.org/1999/02/22-rdf-syntax-ns#\">\n              <rdf:Description rdf:about=\"#COPASI49\">\n                <dcterms:created>\n                  <rdf:Description>\n                    <dcterms:W3CDTF>2019-08-09T16:26:09Z</dcterms:W3CDTF>\n                  </rdf:Description>\n                </dcterms:created>\n              </rdf:Description>\n            </rdf:RDF>\n          </COPASI>\n        </annotation>\n      </parameter>\n      <parameter metaid=\"COPASI50\" id=\"IkB_mRNA_amp\" name=\"IkB_mRNA_amp\" value=\"0\" constant=\"false\">\n        <annotation>\n          <COPASI xmlns=\"http://www.copasi.org/static/sbml\">\n            <rdf:RDF xmlns:dcterms=\"http://purl.org/dc/terms/\" xmlns:rdf=\"http://www.w3.org/1999/02/22-rdf-syntax-ns#\">\n              <rdf:Description rdf:about=\"#COPASI50\">\n                <dcterms:created>\n                  <rdf:Description>\n                    <dcterms:W3CDTF>2019-08-08T13:23:10Z</dcterms:W3CDTF>\n                  </rdf:Description>\n                </dcterms:created>\n              </rdf:Description>\n            </rdf:RDF>\n          </COPASI>\n        </annotation>\n      </parameter>\n      <parameter metaid=\"COPASI51\" id=\"A20_mRNA_amp\" name=\"A20_mRNA_amp\" value=\"0\" constant=\"false\">\n        <annotation>\n          <COPASI xmlns=\"http://www.copasi.org/static/sbml\">\n            <rdf:RDF xmlns:dcterms=\"http://purl.org/dc/terms/\" xmlns:rdf=\"http://www.w3.org/1999/02/22-rdf-syntax-ns#\">\n              <rdf:Description rdf:about=\"#COPASI51\">\n                <dcterms:created>\n                  <rdf:Description>\n                    <dcterms:W3CDTF>2019-08-08T13:23:41Z</dcterms:W3CDTF>\n                  </rdf:Description>\n                </dcter